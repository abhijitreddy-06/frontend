{
  "expo": {
    "name": "Birthday Tracker",
    "slug": "birthday-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "birthdaytracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.birthdaytracker.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.birthdaytracker.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
